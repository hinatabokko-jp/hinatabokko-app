                        <!-- 縦書き表示領域 -->
                        <div class="my-auto flex justify-center items-center py-8">
                            <p id="kaminokuText" class="vertical-text font-mincho text-3xl md:text-4xl lg:text-5xl font-extrabold text-amber-100 leading-snug tracking-widest">
                                秋の田の
                            </p>
                        </div>

                        <div class="text-xs text-gray-500 font-mincho">
                            対応するshimonokuを選択してください
                        </div>
                    </div>
                </div>

                <!-- 右側：shimonoku (下の句) 選択肢5枚 -->
                <div class="md:col-span-7 flex flex-col justify-between">
                    <div class="text-xs text-amber-400 font-bold tracking-widest mb-2 flex items-center gap-2 font-mincho">
                        <i class="fa-solid fa-hand-pointer"></i> shimonoku の選択肢
                    </div>
                    <div id="optionsContainer" class="grid grid-cols-1 gap-3 flex-1">
                        <!-- 動的にJavaScriptで5枚のボタンを生成 -->
                    </div>
                </div>
            </div>

            <!-- ku-zentai（全句）確認モーダル -->
            <div id="explanationModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-md">
                <div class="glass-panel w-full max-w-lg rounded-2xl p-6 md:p-8 space-y-6 shadow-2xl transform transition-all border border-amber-500/40">
                    <div class="flex justify-between items-center border-b border-gray-800 pb-3">
                        <div id="modalResultBadge" class="flex items-center gap-2 text-xl font-bold font-mincho">
                            <!-- 正解 or 残念 -->
                        </div>
                        <span class="text-xs text-amber-400 font-mono font-semibold">ku-zentai</span>
                    </div>

                    <div class="space-y-3">
                        <div class="text-xs text-amber-400 font-semibold tracking-widest font-mincho">【 ku-zentai（歌全体） 】</div>
                        <div class="p-6 rounded-xl bg-slate-950/90 border border-amber-500/30 text-center">
                            <!-- 1行目に1〜3文節、2行目に4〜5文節を表示 -->
                            <div id="kuzentaiText" class="font-mincho text-xl md:text-2xl font-bold text-amber-100 leading-relaxed tracking-wide space-y-2">
                                <!-- JavaScriptにより動的挿入 -->
                            </div>
                        </div>
                    </div>

                    <div class="pt-2 flex justify-end">
                        <button id="nextQuestionBtn" class="px-6 py-3 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-sm flex items-center gap-2 shadow-lg transition-all">
                            <span>次の問題へ</span>
                            <i class="fa-solid fa-chevron-right"></i>
                        </button>
                    </div>
                </div>
            </div>

        </div>

        <!-- ================= 結果表示画面 ================= -->
        <div id="resultScreen" class="hidden w-full max-w-xl text-center space-y-8 my-auto">
            <div class="space-y-3">
                <div class="w-16 h-16 rounded-2xl bg-amber-500/20 border border-amber-400/50 flex items-center justify-center mx-auto text-amber-300 text-2xl font-mincho font-bold shadow-lg">
                    百
                </div>
                <h2 class="text-3xl md:text-4xl font-extrabold font-mincho text-amber-100">結果発表</h2>
                <p class="text-gray-400 text-sm">10問の鍛錬が完了しました。</p>
            </div>

            <div class="glass-panel p-8 rounded-2xl grid grid-cols-2 gap-6 border border-amber-500/30 max-w-md mx-auto">
                <div class="space-y-1">
                    <div class="text-xs text-gray-400 font-medium">正解数</div>
                    <div class="text-4xl font-extrabold font-mincho text-amber-400">
                        <span id="finalScore">0</span> <span class="text-sm font-normal text-gray-400">/ 10</span>
                    </div>
                </div>
                <div class="space-y-1">
                    <div class="text-xs text-gray-400 font-medium">正答率</div>
                    <div class="text-4xl font-extrabold font-mincho text-emerald-400">
                        <span id="accuracyRate">0</span><span class="text-sm font-normal text-gray-400">%</span>
                    </div>
                </div>
            </div>

            <div id="evaluationMessage" class="p-4 rounded-xl bg-slate-950/80 border border-slate-800 text-amber-200 font-mincho text-sm max-w-md mx-auto">
                見事な集中力です！何度も繰り返して百人一首を完璧にマスターしましょう。
            </div>

            <div class="pt-2 flex justify-center">
                <button id="restartBtn" class="px-8 py-3.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-base shadow-xl transition-all flex items-center justify-center gap-2">
                    <i class="fa-solid fa-rotate-right"></i>
                    <span>最初の画面に戻る</span>
                </button>
            </div>
        </div>

    </main>

