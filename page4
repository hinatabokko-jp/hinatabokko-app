            // 全ボタンの非活性化
            const allButtons = optionsContainer.querySelectorAll('button');
            allButtons.forEach(btn => btn.classList.add('disabled', 'pointer-events-none'));

            if (isCorrect) {
                score++;
                currentScore.textContent = score;
                selectedButton.classList.add('correct-animate');
                
                // 正解エフェクト： トイピアノ風ファンファーレ音 ＆ 紙吹雪
                playToyPianoFanfare();
                startConfetti();

                modalResultBadge.innerHTML = `<span class="text-emerald-400"><i class="fa-solid fa-circle-check"></i> 正解！</span>`;
            } else {
                selectedButton.classList.add('wrong-animate');
                playWrongSound();

                // 正解の選択肢カードをハイライト
                allButtons.forEach(btn => {
                    if (btn.textContent.includes(correctQuestion.shimonoku)) {
                        btn.classList.add('border-amber-500', 'bg-amber-500/10');
                    }
                });

                modalResultBadge.innerHTML = `<span class="text-rose-400"><i class="fa-solid fa-circle-xmark"></i> 残念！</span>`;
            }

            // モーダルにku-zentai（全句）を設定（1行目: 1~3文節 / 2行目: 4~5文節）
            const clauses = correctQuestion.kuzentai.trim().split(/[\s　]+/);
            if (clauses.length >= 5) {
                const line1 = clauses.slice(0, 3).join('　');
                const line2 = clauses.slice(3, 5).join('　');
                kuzentaiText.innerHTML = `
                    <div class="text-amber-100">${line1}</div>
                    <div class="text-amber-300 font-semibold">${line2}</div>
                `;
            } else {
                kuzentaiText.textContent = correctQuestion.kuzentai;
            }

            // 少しだけ間を置いて全句モーダルを開く
            setTimeout(() => {
                explanationModal.classList.remove('hidden');
            }, 600);
        }

        // 次の問題または結果画面へ遷移
        function handleNextQuestion() {
            currentQuestionIndex++;
            if (currentQuestionIndex < 10) {
                loadQuestion();
            } else {
                showResultScreen();
            }
        }

        // 10問終了後の結果画面表示
        function showResultScreen() {
            gameScreen.classList.add('hidden');
            explanationModal.classList.add('hidden');
            gameStatusHeader.classList.add('hidden');
            resultScreen.classList.remove('hidden');

            finalScore.textContent = score;
            const rate = Math.round((score / 10) * 100);
            accuracyRate.textContent = rate;

            if (score === 10) {
                evaluationMessage.textContent = '【完璧です！】百人一首の全句を見事に修得しています！';
            } else if (score >= 8) {
                evaluationMessage.textContent = '【素晴らしい！】高い正確さです。全問正解を目指してもう一度挑戦しましょう！';
            } else if (score >= 5) {
                evaluationMessage.textContent = '【順調です！】kaminokuとshimonokuの繋がりを確実に覚えていきましょう。';
            } else {
                evaluationMessage.textContent = '【練習あるのみ！】繰り返し挑戦して全100首を身につけましょう！';
            }
        }

        // イベントリスナー登録
        startBtn.addEventListener('click', initGame);
        restartBtn.addEventListener('click', () => {
            // 最初の画面に戻る
            resultScreen.classList.add('hidden');
            startScreen.classList.remove('hidden');
        });
        nextQuestionBtn.addEventListener('click', handleNextQuestion);

    </script>
</body>
</html>
