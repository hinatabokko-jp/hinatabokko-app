        // ================= Web Audio API: トイピアノ風ファンファーレ音 =================
        let audioCtx = null;

        function playToyPianoFanfare() {
            try {
                const AudioContext = window.AudioContext || window.webkitAudioContext;
                if (!AudioContext) return;
                
                if (!audioCtx) {
                    audioCtx = new AudioContext();
                }
                if (audioCtx.state === 'suspended') {
                    audioCtx.resume();
                }

                // 指示された音階（アルペジオ）： C5 → E5 → G5 → C6 → E6
                const frequencies = [523.25, 659.25, 783.99, 1046.50, 1318.51];
                const startTime = audioCtx.currentTime + 0.02;
                const noteInterval = 0.065; // 素早く鳴り響く和音アルペジオの間隔

                frequencies.forEach((freq, index) => {
                    const noteTime = startTime + (index * noteInterval);

                    // 1. サイン波 (Sine) - やわらかい基音
                    const oscSine = audioCtx.createOscillator();
                    oscSine.type = 'sine';
                    oscSine.frequency.setValueAtTime(freq, noteTime);

                    // 2. 三角波 (Triangle) - ピコピコとしたトイピアノアタック・アコースティック感
                    const oscTri = audioCtx.createOscillator();
                    oscTri.type = 'triangle';
                    oscTri.frequency.setValueAtTime(freq, noteTime);

                    // 音量ゲイン制御
                    const gainSine = audioCtx.createGain();
                    const gainTri = audioCtx.createGain();
                    const masterGain = audioCtx.createGain();

                    // トイピアノ特有のアタックと可憐な残音・速やかな減衰 envelope
                    gainSine.gain.setValueAtTime(0, noteTime);
                    gainSine.gain.linearRampToValueAtTime(0.28, noteTime + 0.006);
                    gainSine.gain.exponentialRampToValueAtTime(0.0001, noteTime + 0.42);

                    gainTri.gain.setValueAtTime(0, noteTime);
                    gainTri.gain.linearRampToValueAtTime(0.20, noteTime + 0.006);
                    gainTri.gain.exponentialRampToValueAtTime(0.0001, noteTime + 0.32);

                    // ノード接続
                    oscSine.connect(gainSine);
                    oscTri.connect(gainTri);
                    gainSine.connect(masterGain);
                    gainTri.connect(masterGain);
                    masterGain.connect(audioCtx.destination);

                    // 再生開始と自動停止
                    oscSine.start(noteTime);
                    oscTri.start(noteTime);
                    oscSine.stop(noteTime + 0.45);
                    oscTri.stop(noteTime + 0.45);
                });
            } catch (e) {
                console.error('Audio playback failed:', e);
            }
        }

